<Page
    x:Class="HedgeModManager.Uwp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="OpenFile" Label="Use E:\\Unleashed\\mods" Click="PickFolder_Click" />
            <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click" />
            <AppBarButton Icon="Save" Label="Save" Click="Save_Click" />
        </CommandBar>

        <Grid x:Name="MainPanel" Grid.Row="1" Padding="24,18,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="HedgeModManager UWP" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="FolderText"
                    Margin="0,6,0,0"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="Using fixed Xbox path: E:\\Unleashed\\mods"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="FilterBox"
                    Header="Filter"
                    PlaceholderText="Search mods"
                    TextChanged="FilterBox_TextChanged" />
                <TextBlock
                    x:Name="CountText"
                    Grid.Column="1"
                    Margin="18,28,0,0"
                    MinWidth="120"
                    TextAlignment="Right" />
            </Grid>

            <Border Grid.Row="2" Padding="10" Background="#221f1f1f" BorderBrush="#33ffffff" BorderThickness="1">
                <TextBlock
                    x:Name="SanityText"
                    FontFamily="Consolas"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Text="Sanity check pending..." />
            </Border>

            <ListView
                x:Name="ModsList"
                Grid.Row="3"
                ItemsSource="{x:Bind FilteredMods, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="74" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch
                                Margin="0,0,18,0"
                                VerticalAlignment="Center"
                                IsOn="{Binding Enabled, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Author}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Version}" />
                                </TextBlock>
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                    Text="{Binding FolderName}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid x:Name="UpdatesPanel" Grid.Row="1" Padding="24,18,24,12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Mod Updates" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="Press LB to return. Select a mod update to view changelog and apply."
                    TextWrapping="Wrap" />
            </StackPanel>

            <CommandBar Grid.Row="1" Margin="0,10,0,10" DefaultLabelPosition="Right">
                <AppBarButton Icon="Refresh" Label="Check updates" Click="CheckUpdates_Click" />
                <AppBarButton Icon="Download" Label="Update selected" Click="UpdateSelected_Click" />
            </CommandBar>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <ListView
                    x:Name="UpdatesList"
                    ItemsSource="{x:Bind Updates, Mode=OneWay}"
                    SelectionChanged="UpdatesList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Mod.Title}" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}">
                                        <Run Text="{Binding Mod.Version}" />
                                        <Run Text=" -> " />
                                        <Run Text="{Binding RemoteVersion}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ScrollViewer Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>

            <TextBlock x:Name="UpdatesStatusText" Grid.Row="3" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="No update check yet." />
        </Grid>

        <Grid x:Name="GameBananaPanel" Grid.Row="1" Padding="24,18,24,12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="GameBanana" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Margin="0,6,0,10"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="Press LB/RB to move between tabs."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MmdlIdBox" Header="mmdl (7 digits)" PlaceholderText="1614367" MaxLength="7" TextChanged="MmdlIdBox_TextChanged" InputScope="Number" />
                <TextBox x:Name="ModIdBox" Grid.Column="1" Margin="10,0,0,0" Header="mod id (6 digits)" PlaceholderText="649915" MaxLength="6" TextChanged="ModIdBox_TextChanged" InputScope="Number" />
                <Button Grid.Column="2" Margin="10,24,0,0" Content="Add Link" Click="AddInstallLink_Click" />
                <Button Grid.Column="3" Margin="10,24,0,0" Content="Install Selected" Click="InstallSelectedLink_Click" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="InstallLinksList" ItemsSource="{x:Bind QuickInstallLinks, Mode=OneWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="{Binding DownloadUrl}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#33ffffff" BorderThickness="1">
                    <WebView x:Name="GameBananaWebView" />
                </Border>
            </Grid>

            <TextBlock
                x:Name="GameBananaStatusText"
                Grid.Row="3"
                Margin="0,10,0,0"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Text="Ready for quick install links." />

        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Padding="24,10"
            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
            Text="Ready" />
    </Grid>
</Page>
